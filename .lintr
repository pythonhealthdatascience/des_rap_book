linters: all_linters(packages = "lintr", undesirable_function_linter = NULL)
encoding: "UTF-8"
exclusions: list(
    "renv",
    "pages/style_docs/linting_resources/code.R",
    "output_analysis/n_reps.qmd" = list(
        commas_linter = Inf,
        unused_import_linter = Inf,
        object_usage_linter = Inf
      )
  )
